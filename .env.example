# Supabase (local development)
# Get the real local values by running `supabase status` after `supabase start`:
#   EXPO_PUBLIC_SUPABASE_URL      -> "API URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY -> "Publishable" key (CLI 2.x label for the anon key)
# NEVER put the service_role key in an EXPO_PUBLIC_* variable or commit it.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
